# ── Core ─────────────────────────────────────────────
DATABASE_URL=postgres://postgres@localhost:5432/ai_company
# Password for the owner account (single-owner app). REQUIRED.
ADMIN_PASSWORD=change-me
# 32+ random chars. Signs session cookies. REQUIRED.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# 64 hex chars (32 bytes). Encrypts credentials stored via the Integrations page. REQUIRED.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Public URL of the app (used in briefing emails / notifications)
APP_URL=http://localhost:3000
# IANA time zone for schedules & briefings
APP_TIMEZONE=Europe/Brussels

# ── Intelligence (required for agents to run) ─────────
ANTHROPIC_API_KEY=
# Optional override (proxy / gateway). Leave empty for https://api.anthropic.com
AI_COMPANY_ANTHROPIC_BASE_URL=

# ── Optional integrations (may also be set on the Integrations page) ──
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=        # optional default voice
OPENAI_API_KEY=            # image generation only (gpt-image-1)
RESEND_API_KEY=            # outbound email + briefing delivery
RESEND_FROM=               # e.g. "AI Company <ops@yourdomain.com>"
RESEND_AUDIENCE_ID=         # newsletter broadcasts
BRIEFING_EMAIL_TO=
SLACK_WEBHOOK_URL=         # notifications
HUBSPOT_ACCESS_TOKEN=      # CRM sync (private app token)
X_ACCESS_TOKEN=            # OAuth2 user-context token with tweet.write
INSTAGRAM_ACCESS_TOKEN=    # Instagram Graph API long-lived token
INSTAGRAM_USER_ID=
LINKEDIN_ACCESS_TOKEN=     # w_member_social
LINKEDIN_AUTHOR_URN=       # urn:li:person:xxxx or urn:li:organization:xxxx
TIKTOK_ACCESS_TOKEN=       # Content Posting API, video.publish scope
TIKTOK_PRIVACY_LEVEL=       # SELF_ONLY until your app is audited
YOUTUBE_ACCESS_TOKEN=      # OAuth2 token with youtube.upload scope

# Optional
WORKER_CONCURRENCY=4
