{
  "name": "ai-company",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "db:migrate:prod": "tsx src/db/migrate.ts",
    "start:worker": "npm run db:migrate:prod && npm run db:seed && tsx src/worker/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@xyflow/react": "^13.0.3",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.6",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "jose": "^6.2.18",
    "lucide-react": "^1.79.0",
    "next": "15.5.29",
    "pg-boss": "^12.39.0",
    "postgres": "^4.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "tsx": "^4.23.15",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
